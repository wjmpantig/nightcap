build/bin
node_modules
frontend/dist

# stray build output
/nightcap.exe
/nightcap

# Private keys never belong in the tree: the GitHub App key that cuts releases
# and the ed25519 key that signs the update manifest. The public half of the
# latter is compiled into update.go on purpose; the private half is a repo
# secret and a backup you hold offline.
*.pem
*private-key*

# wails build writes this to track frontend installs
frontend/package.json.md5

# wails dev's watcher ignores dirs by gitignore-matching absolute paths, and its
# matcher only understands forward slashes -- so its built-in ".*" never matches
# D:\...\.git and every git write triggers a reload. This glob does match.
*.git*
!.gitignore
!.github/
!.gitattributes
